<Window x:Class="_2_EquiposNBA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2_EquiposNBA"
        mc:Ignorable="d"
        Icon="/Assets/basketball.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Title="2_EquiposNBA" 
        Height="450" Width="800">

    <StackPanel Margin="10">

        <Border BorderBrush="Black" BorderThickness="3" CornerRadius="3" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="BlueViolet" Offset="0"/>
                        <GradientStop Color="Yellow" Offset="1"/>
                    </LinearGradientBrush>
                </StackPanel.Background>
                <TextBlock Text="Los Ángeles Lakers" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Image Source="/Assets/9_lakers.png" Height="100" Width="150"/>
                    <Image Source="/Assets/14_lakers.png" Height="100" Width="150"/>
                    <Image Source="/Assets/23_lakers.png" Height="100" Width="150"/>
                    <Image Source="/Assets/3_lakers.png" Height="100" Width="150"/>
                    <Image Source="/Assets/39_lakers.png" Height="100" Width="150"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border BorderBrush="Black" BorderThickness="3" CornerRadius="3" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="Red" Offset="1"/>
                    </LinearGradientBrush>
                </StackPanel.Background>
                <TextBlock Text="Miami Heat" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Image Source="/Assets/7_heat.png" Height="100" Width="150"/>
                    <Image Source="/Assets/14_heat.png" Height="100" Width="150"/>
                    <Image Source="/Assets/22_heat.png" Height="100" Width="150"/>
                    <Image Source="/Assets/99_heat.png" Height="100" Width="150"/>
                    <Image Source="/Assets/13_heat.png" Height="100" Width="150"/>
                </WrapPanel>
            </StackPanel>
        </Border>

    </StackPanel>

</Window>
