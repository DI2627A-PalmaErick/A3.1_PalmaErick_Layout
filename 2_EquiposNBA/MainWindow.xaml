<Window x:Class="_2_EquiposNBA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2_EquiposNBA"
        mc:Ignorable="d"
        Icon="/Assets/basketball.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Title="2_EquiposNBA" 
        Height="450" Width="800">

    <StackPanel Margin="15">
        
        <StackPanel Margin="40,60,0,0" Orientation="Horizontal" HorizontalAlignment="Left">
            <Image Source="/Assets/9_lakers.png" Height="100"/>
            <Image Source="/Assets/14_lakers.png" Height="100"/>
            <Image Source="/Assets/23_lakers.png" Height="100"/>
            <Image Source="/Assets/3_lakers.png" Height="100"/>
            <Image Source="/Assets/39_lakers.png" Height="100"/>
        </StackPanel>

        <StackPanel Margin="40,80,0,0" Orientation="Horizontal" HorizontalAlignment="Left">
            <Image Source="/Assets/7_heat.png" Height="100"/>
            <Image Source="/Assets/14_heat.png" Height="100"/>
            <Image Source="/Assets/22_heat.png" Height="100"/>
            <Image Source="/Assets/99_heat.png" Height="100"/>
            <Image Source="/Assets/13_heat.png" Height="100"/>
        </StackPanel>
    </StackPanel>
    
</Window>
