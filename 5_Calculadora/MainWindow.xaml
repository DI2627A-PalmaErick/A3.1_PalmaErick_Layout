<Window x:Class="_5_Calculadora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_5_Calculadora"
        mc:Ignorable="d"
        Icon="/Assets/numbers.ico"
        Title="Calculadora" 
        WindowStartupLocation="CenterScreen"
        Height="450" Width="450"
        MinHeight="400" MinWidth="350">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="Black" BorderThickness="1" Margin="5">
            <Viewbox HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0">
                <TextBlock x:Name="pantallaTextBlock" Text=""/>
            </Viewbox>
        </Border>

        <Button Grid.Row="1" Grid.Column="0" Content="1" Tag="1" Click="Boton_Click" FontSize="30" Margin="5"/>
        <Button Grid.Row="1" Grid.Column="1" Content="2" Tag="2" Click="Boton_Click" FontSize="30" Margin="5"/>
        <Button Grid.Row="1" Grid.Column="2" Content="3" Tag="3" Click="Boton_Click" FontSize="30" Margin="5"/>

        <Button Grid.Row="2" Grid.Column="0" Content="4" Tag="4" Click="Boton_Click" FontSize="30" Margin="5"/>
        <Button Grid.Row="2" Grid.Column="1" Content="5" Tag="5" Click="Boton_Click" FontSize="30" Margin="5"/>
        <Button Grid.Row="2" Grid.Column="2" Content="6" Tag="6" Click="Boton_Click" FontSize="30" Margin="5"/>

        <Button Grid.Row="3" Grid.Column="0" Content="7" Tag="7" Click="Boton_Click" FontSize="30" Margin="5"/>
        <Button Grid.Row="3" Grid.Column="1" Content="8" Tag="8" Click="Boton_Click" FontSize="30" Margin="5"/>
        <Button Grid.Row="3" Grid.Column="2" Content="9" Tag="9" Click="Boton_Click" FontSize="30" Margin="5"/>

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Content="0" Tag="0" Click="Boton_Click" FontSize="30" Margin="5"/>

    </Grid>

</Window>
