<Window x:Class="_3_Mosaico.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3_Mosaico"
        mc:Ignorable="d"
        Icon="/Assets/mosaic.ico"
        WindowStartupLocation="CenterScreen"
        Title="Mosaico" 
        Height="600" Width="600"
        MinWidth="500" MinHeight="530">

    <DockPanel LastChildFill="True">

        <TextBlock DockPanel.Dock="Top" Text="" Background="Red" Height="100"/>
        <TextBlock DockPanel.Dock="Left" Text="" Background="Red" Width="100"/>

        <TextBlock DockPanel.Dock="Bottom" Text="" Background="DarkGreen" Height="100"/>
        <TextBlock DockPanel.Dock="Right" Text="" Background="DarkGreen" Width="100"/>

        <TextBlock DockPanel.Dock="Left" Text="" Background="Orange" Width="100"/>
        <TextBlock DockPanel.Dock="Bottom" Text="" Background="Orange" Height="100"/>

        <TextBlock DockPanel.Dock="Top" Text="" Background="DarkViolet" Height="100"/>
        <TextBlock DockPanel.Dock="Right" Text="" Background="DarkViolet" Width="100"/>

        <TextBlock Text="" Background="Black"/>

    </DockPanel>

</Window>
